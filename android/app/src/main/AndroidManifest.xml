<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Android App Links: a tap on any https://doctoguide.knocdoc.in link
                (WhatsApp, Gmail, a Google result, another site in Chrome) opens
                this app instead of the browser when it is installed.

                autoVerify only succeeds if the site serves
                /.well-known/assetlinks.json (public/.well-known/) listing the
                SHA-256 of the certificate that signed THIS build. Unverified, the
                link still opens Chrome — nothing breaks, it just is not a deep link.

                DeepLinkService routes the URL once the app is open.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="doctoguide.knocdoc.in" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Required by @capacitor/geolocation. `cap sync` wires the plugin's code
        but does NOT add permissions, and without these Geolocation.getCurrentPosition()
        rejects silently in the APK — the app then falls through to asking the
        user to type a city, which looks like a bug rather than a permission gap.

        COARSE is what the app actually needs (city-level doctor search calls
        getCurrentPosition with enableHighAccuracy:false); FINE is declared
        because Android 12+ lets the user grant either from one prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
