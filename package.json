{
  "name": "doctoguide",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4700",
    "build": "node scripts/check-prerender-list.mjs && ng build && node scripts/postbuild-seo.js",
    "build:cap": "ng build --configuration production,capacitor",
    "cap:sync": "npm run build:cap && npx cap sync android",
    "cap:open": "npm run cap:sync && npx cap open android",
    "cap:run": "npm run cap:sync && npx cap run android",
    "apk:debug": "npm run cap:sync && node scripts/gradle.mjs assembleDebug",
    "apk:release": "npm run cap:sync && node scripts/gradle.mjs bundleRelease",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:doctoguide": "node dist/doctoguide/server/server.mjs",
    "seo:check": "node scripts/seo-check.js",
    "parity": "node scripts/parity-diff.mjs dist/doctoguide/browser ../doctoguide-v2-baseline",
    "parity:snapshot": "node scripts/parity-snapshot.mjs",
    "parity:behaviour": "node scripts/parity-behaviour.mjs ../AIDoctorFront .",
    "serve:cap": "node scripts/serve-cap.mjs",
    "prerender:check": "node scripts/check-prerender-list.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.27",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "express": "^4.22.2",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "autoprefixer": "^10.5.4",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2"
  }
}
